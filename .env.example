# -----------------------------------------------------------------------------
# Media server configuration
#
# Copy this file to ".env" and edit the paths to match your machine.
# The setup script (setup.ps1 / setup.sh) does this automatically.
# -----------------------------------------------------------------------------

# Timezone (see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones).
TZ=America/New_York

# User/group IDs for container file ownership.
# These are ignored on Windows (Docker Desktop handles permissions),
# but should match `id -u` / `id -g` on Linux/macOS.
PUID=1000
PGID=1000

# Where service configs live (containers persist their state here).
# Use forward slashes even on Windows: C:/media-server/config
CONFIG_ROOT=./config

# Where downloads land. qBittorrent writes here; Sonarr/Radarr import from here.
# Sub-folders "complete" and "incomplete" are created automatically.
DOWNLOADS_ROOT=./downloads

# Your media library. Must contain "movies" and "tv" sub-folders.
# This is what you point Plex at.
MEDIA_ROOT=./media

# -----------------------------------------------------------------------------
# VPN settings (optional)
#
# Only used when you start the stack with docker-compose.vpn.yml (or
# setup.ps1 -Vpn / setup.sh --vpn). When enabled, qBittorrent's traffic is
# routed through a Gluetun VPN container; everything else stays on the LAN.
#
# Pick a provider supported by gluetun (full list in the wiki):
#   https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
#
# --- Example: Mullvad (WireGuard) ---
# VPN_SERVICE_PROVIDER=mullvad
# VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=<key from Mullvad account page>
# WIREGUARD_ADDRESSES=10.x.x.x/32
# VPN_COUNTRIES=Sweden
#
# --- Example: ProtonVPN (WireGuard) ---
# VPN_SERVICE_PROVIDER=protonvpn
# VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=<from "WireGuard configuration" in Proton account>
# WIREGUARD_ADDRESSES=10.2.0.2/32
# VPN_COUNTRIES=Netherlands
#
# --- Example: NordVPN (OpenVPN — easiest path) ---
# Get service credentials at:
#   https://my.nordaccount.com/dashboard/nordvpn/manual-configuration/service-credentials/
# (These are NOT your account email/password — Nord generates separate ones.)
# VPN_SERVICE_PROVIDER=nordvpn
# VPN_TYPE=openvpn
# OPENVPN_USER=<service username, long random string>
# OPENVPN_PASSWORD=<service password>
# VPN_COUNTRIES=Switzerland
# VPN_CATEGORIES=P2P     # restrict to P2P-optimised servers
#
# --- Example: NordVPN (WireGuard / NordLynx — faster, see README) ---
# VPN_SERVICE_PROVIDER=nordvpn
# VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=<extracted with the bubuntux/nordlynx helper, see README>
# WIREGUARD_ADDRESSES=10.5.0.2/32
# VPN_COUNTRIES=Switzerland
# VPN_CATEGORIES=P2P
#
# Your local network — gluetun blocks anything else outbound.
# Use your actual subnet: run `ipconfig` (Windows) or `ip route` (Linux) to find it.
# Common values: 192.168.1.0/24, 192.168.0.0/24, 10.0.0.0/24, 172.16.0.0/24
# Avoid /16 or wider — it allows unnecessary outbound traffic.
LAN_SUBNET=192.168.1.0/24

VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
WIREGUARD_PRESHARED_KEY=
OPENVPN_USER=
OPENVPN_PASSWORD=
VPN_COUNTRIES=
VPN_CITIES=
VPN_REGIONS=
# Provider-specific server filter. NordVPN supports e.g. "P2P" to restrict
# to P2P-optimised servers. Most providers don't use this; leave blank.
VPN_CATEGORIES=

# -----------------------------------------------------------------------------
# Telegram bot (optional)
#
# Only used when you start the stack with docker-compose.telegram.yml
# (or setup.ps1 -Telegram / setup.sh --telegram). Adds a Searcharr bot
# that lets you request movies and TV shows from Telegram.
#
# See README "Telegram requests" for the BotFather walkthrough.
# -----------------------------------------------------------------------------

# Bot token from @BotFather. Looks like 1234567890:AAA-bb_CC... (~46 chars).
TELEGRAM_BOT_TOKEN=

# Password users must send with /start <password> to use the bot.
# Leave blank to have the setup script generate a strong random one.
TELEGRAM_BOT_PASSWORD=

# Admin password (controls /users command). Leave blank to auto-generate.
# Treat this like a root password — never share or post it in a group chat.
TELEGRAM_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Diun update notifier (optional)
#
# Only used when you start the stack with docker-compose.diun.yml. Notifies
# you when an upstream image has a newer digest than what's pinned in your
# compose files. Pairs with update.sh / update.ps1 (which has the 7-day
# quarantine and does the actual updating).
#
# Pick ONE notification channel and fill in just its fields; leave the rest
# blank. For channels not listed here (SMTP, Gotify, Matrix, MS Teams, etc.)
# drop a YAML config file at config/diun/diun.yml — Diun loads it
# automatically. See https://crazymax.dev/diun/config/ for the schema.
#
# With no channel configured, Diun still runs and logs update events
# to docker logs diun.
# -----------------------------------------------------------------------------

# Cron schedule for the update check (default: every day at 09:00).
DIUN_WATCH_SCHEDULE=0 0 9 * * *

# --- Channel 1: Telegram (the simplest; reuse your bot from above) ---
# Send your bot a message first, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates  to find your chat ID.
DIUN_NOTIF_TELEGRAM_TOKEN=
DIUN_NOTIF_TELEGRAM_CHATIDS=

# --- Channel 2: Discord webhook ---
DIUN_NOTIF_DISCORD_WEBHOOKURL=

# --- Channel 3: Slack webhook ---
DIUN_NOTIF_SLACK_WEBHOOKURL=


